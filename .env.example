# 云同步配置（可选）。不填 = 纯本地应用，登录与同步入口自动隐藏。
# 配置与客户端构建说明见 docs/SELF-HOSTING.md
#
# 复制成 .env.local 后填入你自己的值；.env.local 已被 gitignore。
VITE_CLOUD_ENDPOINT=
# Android default builds keep the WebView origin at localhost. Set to 1 only when
# building an Android client for the endpoint configured above.
VITE_ANDROID_CLOUD_MODE=
VITE_CLOUD_OAUTH_RELAY=
VITE_CLOUD_KEY=
VITE_CLOUD_RESOURCE_ID=

# 分享码（托管方的访问门禁参数；开源构建留空 = 不做更新检查）
VITE_SHARE_CODE=

# CSP 白名单用的 OAuth 中转来源（只填 origin，不填路径）
VITE_CLOUD_OAUTH_ORIGIN=
